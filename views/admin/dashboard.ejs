<%- include('../layout/header') %>

  <div class="space-y-6">
    <!-- Top Banner / Title & Session Control -->
    <div
      class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-3">
          <span class="p-2.5 bg-blue-50 text-blue-600 rounded-xl text-lg font-bold">
            <i class="fa-solid fa-gauge-high"></i>
          </span>
          <div>
            <h1 class="text-xl font-extrabold text-slate-800">Pusat Kendali Admin KPU Sekolah</h1>
            <p class="text-xs text-slate-500">Kelola master paslon, jadwal pemungutan suara, dan pantau integritas
              audit.</p>
          </div>
        </div>
      </div>

      <!-- Sesi Voting Toggle Action -->
      <div class="flex items-center space-x-3">
        <div class="text-right">
          <span class="text-[11px] font-semibold text-slate-400 block uppercase tracking-wider">Status Pemilihan</span>
          <% if (session && session.isOpen) { %>
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-300">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping mr-1.5"></span>SEDANG DIBUKA
            </span>
            <% } else { %>
              <span
                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-700 border border-rose-300">
                <span class="w-2 h-2 rounded-full bg-rose-500 mr-1.5"></span>TERKUNCI / DITUTUP
              </span>
              <% } %>
        </div>

        <% if (session && session.isOpen) { %>
          <form action="/admin/session/toggle" method="POST" class="inline"
            onsubmit="return confirm('Kunci sesi pemungutan suara sekarang? Pemilih tidak akan dapat mencoblos.')">
            <button type="submit"
              class="px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-xl shadow-md shadow-rose-600/20 transition flex items-center space-x-1.5">
              <i class="fa-solid fa-lock"></i>
              <span>Kunci Sesi Voting</span>
            </button>
          </form>
          <% } else { %>
            <form action="/admin/session/toggle" method="POST" class="inline"
              onsubmit="return confirm('Buka sesi pemungutan suara sekarang? Siswa dapat mulai mencoblos.')">
              <button type="submit"
                class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-md shadow-emerald-600/20 transition flex items-center space-x-1.5">
                <i class="fa-solid fa-lock-open"></i>
                <span>Buka Sesi Voting</span>
              </button>
            </form>
            <% } %>
      </div>
    </div>

    <!-- Statistik Cards (4 Kolom) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1: Total DPT -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Total DPT Siswa</p>
            <h3 class="text-2xl font-black text-slate-800 mt-1">
              <%= totalDPT %> <span class="text-xs font-normal text-slate-500">pemilih</span>
            </h3>
          </div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>
        <div class="mt-3 text-[11px] text-slate-500 flex items-center">
          <i class="fa-solid fa-circle-check text-blue-500 mr-1"></i> Data Pemilih Tetap Terverifikasi
        </div>
      </div>

      <!-- Card 2: Suara Masuk -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Suara Telah Masuk</p>
            <h3 class="text-2xl font-black text-emerald-600 mt-1">
              <%= totalSuara %> <span class="text-xs font-normal text-slate-500">suara sah</span>
            </h3>
          </div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-check-to-slot"></i>
          </div>
        </div>
        <div class="mt-3 text-[11px] text-slate-500 flex items-center">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-1.5"></span> Tercatat di bilik suara
        </div>
      </div>

      <!-- Card 3: Partisipasi -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Tingkat Partisipasi</p>
            <h3 class="text-2xl font-black text-indigo-600 mt-1">
              <%= partisipasi %>%
            </h3>
          </div>
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-chart-pie"></i>
          </div>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-1.5 mt-3 overflow-hidden">
          <div class="bg-indigo-600 h-1.5 rounded-full transition-all duration-500" style="width: <%= partisipasi %>%">
          </div>
        </div>
      </div>

      <!-- Card 4: Belum Memilih -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Belum Memberikan Suara</p>
            <h3 class="text-2xl font-black text-amber-600 mt-1">
              <%= totalDPT - totalSuara %> <span class="text-xs font-normal text-slate-500">siswa</span>
            </h3>
          </div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-hourglass-half"></i>
          </div>
        </div>
        <div class="mt-3 text-[11px] text-slate-500 flex items-center">
          <i class="fa-solid fa-circle-info text-amber-500 mr-1"></i> Menunggu antrean / token TPS
        </div>
      </div>
    </div>

    <!-- Paslon Quick Overview & Live Bar -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Kolom 1 & 2: Quick Chart Paslon -->
      <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-slate-800">Perolehan Suara Pasangan Calon (Live)</h2>
            <p class="text-xs text-slate-500">Real-time update dari bilik suara digital</p>
          </div>
          <a href="/admin/quick-count"
            class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center space-x-1">
            <span>Lihat Quick Count Lengkap</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="space-y-4">
          <% candidates.forEach(c=> {
            const pct = totalSuara > 0 ? ((c.suaraCount / totalSuara) * 100).toFixed(1) : 0;
            %>
            <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center space-x-3">
                  <span
                    class="w-7 h-7 rounded-lg bg-blue-600 text-white font-black text-xs flex items-center justify-center shadow-sm">
                    0<%= c.nomorUrut %>
                  </span>
                  <div>
                    <h4 class="text-sm font-bold text-slate-800">
                      <%= c.namaKetua %> &amp; <%= c.namaWakil %>
                    </h4>
                    <p class="text-[11px] text-slate-500 line-clamp-1">
                      <%= c.visi %>
                    </p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-base font-black text-slate-800">
                    <%= c.suaraCount %>
                  </span>
                  <span class="text-xs text-slate-500 font-semibold">(<%= pct %>%)</span>
                </div>
              </div>
              <!-- Progress Bar -->
              <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                <div class="bg-gradient-to-r from-blue-500 to-indigo-600 h-2.5 rounded-full transition-all duration-500"
                  style="width: <%= pct %>%"></div>
              </div>
            </div>
            <% }) %>
        </div>
      </div>

      <!-- Kolom 3: Audit Log Cepat -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-bold text-slate-800">Aktivitas Sistem Terkini</h2>
          <a href="/admin/audit-log" class="text-xs text-blue-600 hover:text-blue-700 font-semibold">Semua &rarr;</a>
        </div>
        <div class="space-y-3 flex-1 overflow-y-auto max-h-80 pr-1">
          <% if (recentLogs && recentLogs.length> 0) { %>
            <% recentLogs.slice(0, 6).forEach(log=> { %>
              <div class="text-xs p-2.5 rounded-xl border border-slate-100 bg-slate-50">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-slate-700">
                    <%= log.action %>
                  </span>
                  <span class="text-[10px] text-slate-400">
                    <%= new Date(log.createdAt).toLocaleTimeString('id-ID') %>
                  </span>
                </div>
                <p class="text-slate-600 text-[11px]">
                  <%= log.detail %>
                </p>
                <div class="mt-1 flex items-center space-x-1 text-[10px] text-slate-400">
                  <i class="fa-solid fa-user text-[9px]"></i>
                  <span>
                    <%= log.userName %> (<%= log.role %>)
                  </span>
                </div>
              </div>
              <% }) %>
                <% } else { %>
                  <p class="text-xs text-slate-400 italic">Belum ada riwayat aktivitas.</p>
                  <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../layout/footer') %>
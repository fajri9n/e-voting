<%- include('../layout/header') %>

<div class="max-w-2xl mx-auto my-4">
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
      <div>
        <h1 class="text-lg font-extrabold text-slate-800">
          <%= candidate ? 'Edit Data Pasangan Calon' : 'Tambah Pasangan Calon Baru' %>
        </h1>
        <p class="text-xs text-slate-500">Lengkapi informasi pasangan calon ketua dan wakil ketua OSIS/MPK.</p>
      </div>
      <a href="/admin/candidates" class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center">
        <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
      </a>
    </div>

    <form action="<%= candidate ? `/admin/candidates/${candidate.id}/edit` : '/admin/candidates/add' %>"
      method="POST" enctype="multipart/form-data" class="space-y-5">

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="nomorUrut" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            Nomor Urut <span class="text-red-500">*</span>
          </label>
          <input type="number" id="nomorUrut" name="nomorUrut" min="1" max="99" required
            value="<%= candidate ? candidate.nomorUrut : '' %>"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition"
            placeholder="1">
        </div>

        <div class="sm:col-span-2">
          <label for="foto" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            Foto Resmi Paslon (JPG/PNG/WEBP)
          </label>
          <input type="file" id="foto" name="foto" accept="image/*"
            class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer">
          <% if (candidate && candidate.fotoUrl) { %>
            <p class="text-[11px] text-slate-400 mt-1">Foto saat ini: <a href="<%= candidate.fotoUrl %>" target="_blank" class="text-indigo-600 underline">Lihat Foto</a></p>
          <% } %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="namaKetua" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            Nama Calon Ketua OSIS <span class="text-red-500">*</span>
          </label>
          <input type="text" id="namaKetua" name="namaKetua" required
            value="<%= candidate ? candidate.namaKetua : '' %>"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition"
            placeholder="Contoh: Ahmad Fadhil">
        </div>

        <div>
          <label for="namaWakil" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            Nama Calon Wakil Ketua OSIS <span class="text-red-500">*</span>
          </label>
          <input type="text" id="namaWakil" name="namaWakil" required
            value="<%= candidate ? candidate.namaWakil : '' %>"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition"
            placeholder="Contoh: Siti Nurhaliza">
        </div>
      </div>

      <div>
        <label for="visi" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Visi Utama Paslon <span class="text-red-500">*</span>
        </label>
        <textarea id="visi" name="visi" rows="3" required
          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition"
          placeholder="Tuliskan rumusan visi pasangan calon..."><%= candidate ? candidate.visi : '' %></textarea>
      </div>

      <div>
        <label for="misi" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Misi Paslon (Gunakan penomoran poin-poin) <span class="text-red-500">*</span>
        </label>
        <textarea id="misi" name="misi" rows="5" required
          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition"
          placeholder="1. Meningkatkan literasi digital&#10;2. Mengadakan festival seni&#10;3. Membentuk kotak saran digital"><%= candidate ? candidate.misi : '' %></textarea>
      </div>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
        <a href="/admin/candidates" class="px-4 py-2 text-xs font-bold text-slate-600 hover:text-slate-800 transition">
          Batal
        </a>
        <button type="submit"
          class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md shadow-indigo-600/20 transition flex items-center space-x-1.5">
          <i class="fa-solid fa-floppy-disk"></i>
          <span><%= candidate ? 'Simpan Perubahan' : 'Tambahkan Paslon' %></span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../layout/footer') %>

<%- include('../layout/header') %>

<div class="max-w-md mx-auto my-12 text-center">
  <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xl">
    <div class="w-20 h-20 mx-auto mb-4 rounded-3xl bg-amber-50 text-amber-600 flex items-center justify-center text-4xl shadow-inner">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <span class="text-xs font-black uppercase tracking-widest text-amber-600 bg-amber-50 px-3 py-1 rounded-full">
      500 SERVER ERROR
    </span>
    <h1 class="text-xl font-extrabold text-slate-800 mt-3 mb-1">Terjadi Kesalahan Server</h1>
    <p class="text-xs text-slate-500 mb-6">
      <%= typeof error !== 'undefined' ? error : 'Silakan coba beberapa saat lagi atau hubungi panitia teknis.' %>
    </p>

    <a href="/"
      class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow transition block">
      Muat Ulang Halaman
    </a>
  </div>
</div>

<%- include('../layout/footer') %>

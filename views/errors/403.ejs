<%- include('../layout/header') %>

<div class="max-w-md mx-auto my-12 text-center">
  <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xl">
    <div class="w-20 h-20 mx-auto mb-4 rounded-3xl bg-rose-50 text-rose-600 flex items-center justify-center text-4xl shadow-inner">
      <i class="fa-solid fa-ban"></i>
    </div>
    <span class="text-xs font-black uppercase tracking-widest text-rose-600 bg-rose-50 px-3 py-1 rounded-full">
      403 FORBIDDEN
    </span>
    <h1 class="text-xl font-extrabold text-slate-800 mt-3 mb-1">Akses Halaman Dibatasi</h1>
    <p class="text-xs text-slate-500 mb-6">
      Akun Anda tidak memiliki hak akses (Role-Based Access Control) untuk membuka modul ini.
    </p>

    <div class="space-y-2">
      <a href="/"
        class="w-full py-2.5 px-4 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow transition block">
        Kembali ke Beranda Sesuai Peran
      </a>
      <form action="/auth/logout" method="POST">
        <button type="submit"
          class="w-full py-2 px-4 text-xs font-bold text-rose-600 hover:bg-rose-50 rounded-xl transition">
          Ganti Akun / Logout
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('../layout/footer') %>

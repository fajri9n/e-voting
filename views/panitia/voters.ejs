<%- include('../layout/header') %>

<div class="space-y-6">
  <!-- Header & Alert -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-xl font-extrabold text-slate-800 flex items-center">
        <i class="fa-solid fa-user-check text-emerald-600 mr-2"></i>
        Meja Verifikasi Pemilih &amp; Penerbitan Token
      </h1>
      <p class="text-xs text-slate-500">Pastikan siswa hadir secara fisik di TPS, cocokkan kartu pelajar/NISN, lalu terbitkan token sekali pakai.</p>
    </div>

    <div>
      <% if (session && session.isOpen) { %>
        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-300">
          <i class="fa-solid fa-circle-check mr-1.5 text-emerald-600"></i>Sesi Buka - Siap Terbitkan Token
        </span>
      <% } else { %>
        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-rose-100 text-rose-700 border border-rose-300">
          <i class="fa-solid fa-circle-xmark mr-1.5 text-rose-600"></i>Sesi Ditutup - Token Tidak Dapat Dibuat
        </span>
      <% } %>
    </div>
  </div>

  <!-- Form Verifikasi Cepat NISN -->
  <div class="bg-gradient-to-r from-emerald-50 via-teal-50 to-blue-50 rounded-2xl p-5 border border-emerald-200 shadow-sm">
    <div class="max-w-xl">
      <h3 class="text-sm font-extrabold text-slate-800 mb-1 flex items-center">
        <i class="fa-solid fa-magnifying-glass text-emerald-600 mr-2"></i>
        Cek Cepat Keabsahan DPT (Scan / Masukkan NISN)
      </h3>
      <p class="text-xs text-slate-500 mb-3">Ketikkan 10 digit NISN pemilih untuk mengecek apakah sudah pernah memilih atau belum.</p>
      
      <form action="/panitia/voters/verifikasi" method="POST" class="flex gap-2">
        <input type="text" name="nisn" required placeholder="Contoh: 0051234001"
          class="flex-1 px-3.5 py-2 bg-white border border-emerald-300 rounded-xl text-xs font-mono font-bold focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
        <button type="submit"
          class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow transition flex items-center space-x-1.5">
          <i class="fa-solid fa-id-card-clip"></i>
          <span>Periksa Kehadiran</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Tabel DPT dengan Fitur Generate Token -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <h3 class="text-sm font-bold text-slate-800">Daftar Pemilih TPS</h3>
        <p class="text-[11px] text-slate-400">Tekan tombol "Generate Token" saat siswa sudah berada di depan meja petugas TPS.</p>
      </div>
      <input type="text" id="voterSearch" onkeyup="filterVoterTable()" placeholder="Ketik nama / NISN / kelas..."
        class="w-full sm:w-64 px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs" id="votersTable">
        <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">No</th>
            <th class="py-3 px-4">NISN</th>
            <th class="py-3 px-4">Nama Lengkap</th>
            <th class="py-3 px-4">Kelas</th>
            <th class="py-3 px-4">Status Hak Suara</th>
            <th class="py-3 px-4">Token Aktif</th>
            <th class="py-3 px-4 text-center">Aksi Petugas TPS</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% voters.forEach((v, idx) => { %>
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3 px-4 text-slate-400 font-medium"><%= idx + 1 %></td>
              <td class="py-3 px-4 font-mono font-semibold text-slate-700"><%= v.nisn %></td>
              <td class="py-3 px-4 font-bold text-slate-800"><%= v.nama %></td>
              <td class="py-3 px-4 text-slate-600"><%= v.kelas %></td>
              <td class="py-3 px-4">
                <% if (v.hasVoted) { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">
                    <i class="fa-solid fa-check text-[9px] mr-1"></i>Sudah Memilih
                  </span>
                <% } else if (v.token) { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-700 border border-amber-200">
                    <i class="fa-solid fa-ticket text-[9px] mr-1"></i>Token Siap Pakai
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-600 border border-slate-200">
                    <i class="fa-solid fa-clock text-[9px] mr-1"></i>Belum Registrasi
                  </span>
                <% } %>
              </td>
              <td class="py-3 px-4">
                <% if (v.token) { %>
                  <div class="flex items-center space-x-1.5">
                    <span class="font-mono font-bold text-sm bg-blue-50 text-blue-700 border border-blue-200 px-2 py-0.5 rounded tracking-widest"><%= v.token %></span>
                    <button type="button" onclick="navigator.clipboard.writeText('<%= v.token %>'); alert('Token <%= v.token %> disalin!');" title="Salin Token"
                      class="text-slate-400 hover:text-blue-600 text-xs">
                      <i class="fa-regular fa-copy"></i>
                    </button>
                  </div>
                <% } else if (v.hasVoted) { %>
                  <span class="text-slate-400 italic text-[11px]">Hangus Otomatis</span>
                <% } else { %>
                  <span class="text-slate-400 italic text-[11px]">-</span>
                <% } %>
              </td>
              <td class="py-3 px-4 text-center">
                <% if (!v.hasVoted) { %>
                  <form action="/panitia/voters/<%= v.id %>/token" method="POST" class="inline"
                    onsubmit="return confirm('Generate token voting sekali pakai untuk siswa ini?')">
                    <button type="submit" <%= (!session || !session.isOpen) ? 'disabled title="Sesi belum dibuka oleh admin"' : '' %>
                      class="px-3 py-1 text-xs font-bold rounded-xl transition flex items-center justify-center space-x-1 mx-auto
                        <%= (!session || !session.isOpen) 
                          ? 'bg-slate-100 text-slate-400 cursor-not-allowed border border-slate-200' 
                          : (v.token 
                              ? 'bg-amber-500 hover:bg-amber-600 text-white shadow-sm' 
                              : 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm') %>">
                      <i class="fa-solid fa-ticket mr-1"></i>
                      <span><%= v.token ? 'Generate Ulang' : 'Generate Token' %></span>
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-slate-400 text-[11px] font-semibold">
                    <i class="fa-solid fa-lock text-[9px] mr-1"></i>Selesai
                  </span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function filterVoterTable() {
    const query = document.getElementById('voterSearch').value.toLowerCase();
    const rows = document.querySelectorAll('#votersTable tbody tr');
    rows.forEach(r => {
      const text = r.textContent.toLowerCase();
      r.style.display = text.includes(query) ? '' : 'none';
    });
  }
</script>

<%- include('../layout/footer') %>

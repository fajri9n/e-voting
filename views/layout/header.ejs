<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'E-Voting OSIS & MPK' %></title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
            }
          }
        }
      }
    }
  </script>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; font-size: 11pt; }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

<% if (typeof user !== 'undefined' && user) { %>
<!-- Top Navbar -->
<header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
          <i class="fa-solid fa-check-to-slot text-lg"></i>
        </div>
        <div>
          <span class="text-base font-bold bg-gradient-to-r from-blue-700 to-indigo-700 bg-clip-text text-transparent">E-VOTING OSIS & MPK</span>
          <span class="hidden md:inline-block ml-2 px-2 py-0.5 text-xs font-semibold rounded-full <%= user.role === 'ADMIN' ? 'bg-purple-100 text-purple-700 border border-purple-200' : (user.role === 'PANITIA_TPS' ? 'bg-amber-100 text-amber-700 border border-amber-200' : 'bg-emerald-100 text-emerald-700 border border-emerald-200') %>">
            <i class="fa-solid fa-shield-halved mr-1"></i><%= user.role === 'ADMIN' ? 'ADMIN KPU' : (user.role === 'PANITIA_TPS' ? 'PANITIA TPS' : 'PEMILIH') %>
          </span>
        </div>
      </div>

      <!-- Navigation links based on role -->
      <nav class="hidden md:flex items-center space-x-1">
        <% if (user.role === 'ADMIN') { %>
          <a href="/admin/dashboard" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-chart-pie mr-1.5 text-blue-600"></i>Dashboard
          </a>
          <a href="/admin/candidates" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-users mr-1.5 text-indigo-600"></i>Paslon
          </a>
          <a href="/admin/voters" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-id-card mr-1.5 text-teal-600"></i>DPT Pemilih
          </a>
          <a href="/admin/quick-count" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-square-poll-vertical mr-1.5 text-emerald-600"></i>Quick Count
          </a>
          <a href="/admin/audit-log" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-clock-rotate-left mr-1.5 text-amber-600"></i>Audit Log
          </a>
        <% } else if (user.role === 'PANITIA_TPS') { %>
          <a href="/panitia/dashboard" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-gauge mr-1.5 text-blue-600"></i>Dashboard TPS
          </a>
          <a href="/panitia/voters" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-user-check mr-1.5 text-emerald-600"></i>Verifikasi & Token
          </a>
          <a href="/panitia/quick-count" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-chart-column mr-1.5 text-indigo-600"></i>Quick Count
          </a>
          <a href="/panitia/berita-acara" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 text-slate-700 transition">
            <i class="fa-solid fa-file-invoice mr-1.5 text-purple-600"></i>Berita Acara
          </a>
        <% } %>
        <a href="/live-count" target="_blank" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-blue-600 transition">
          <i class="fa-solid fa-tower-broadcast text-rose-500 mr-1 animate-pulse"></i>Live Publik
        </a>
      </nav>

      <!-- User Dropdown & Logout -->
      <div class="flex items-center space-x-3">
        <div class="text-right hidden sm:block">
          <p class="text-xs font-semibold text-slate-800 leading-tight"><%= user.nama %></p>
          <p class="text-[11px] text-slate-500">@<%= user.username %></p>
        </div>
        <form action="/auth/logout" method="POST" class="inline">
          <button type="submit" title="Keluar dari sistem" class="inline-flex items-center px-3 py-1.5 border border-red-200 text-xs font-semibold rounded-lg text-red-600 bg-red-50 hover:bg-red-100 hover:border-red-300 transition">
            <i class="fa-solid fa-arrow-right-from-bracket mr-1.5"></i>Logout
          </button>
        </form>
      </div>
    </div>
  </div>
</header>
<% } %>

<!-- Flash Notifications -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full no-print">
  <% if (typeof success !== 'undefined' && success.length > 0) { %>
    <div class="p-4 mb-3 text-sm text-emerald-800 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center shadow-sm">
      <i class="fa-solid fa-circle-check text-emerald-500 text-lg mr-3 flex-shrink-0"></i>
      <div><%- success.join('<br>') %></div>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error.length > 0) { %>
    <div class="p-4 mb-3 text-sm text-red-800 rounded-xl bg-red-50 border border-red-200 flex items-center shadow-sm">
      <i class="fa-solid fa-circle-exclamation text-red-500 text-lg mr-3 flex-shrink-0"></i>
      <div><%- error.join('<br>') %></div>
    </div>
  <% } %>
  <% if (typeof warning !== 'undefined' && warning.length > 0) { %>
    <div class="p-4 mb-3 text-sm text-amber-800 rounded-xl bg-amber-50 border border-amber-200 flex items-center shadow-sm">
      <i class="fa-solid fa-triangle-exclamation text-amber-500 text-lg mr-3 flex-shrink-0"></i>
      <div><%- warning.join('<br>') %></div>
    </div>
  <% } %>
  <% if (typeof info !== 'undefined' && info.length > 0) { %>
    <div class="p-4 mb-3 text-sm text-blue-800 rounded-xl bg-blue-50 border border-blue-200 flex items-center shadow-sm">
      <i class="fa-solid fa-circle-info text-blue-500 text-lg mr-3 flex-shrink-0"></i>
      <div><%- info.join('<br>') %></div>
    </div>
  <% } %>
</div>

<main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

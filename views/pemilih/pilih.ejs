<%- include('../layout/header') %>

<div class="space-y-6 max-w-6xl mx-auto my-4">
  <!-- Identitas Pemilih Banner -->
  <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center space-x-3">
      <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
        <i class="fa-solid fa-user-graduate"></i>
      </div>
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full">Surat Suara Sah</span>
        <h2 class="text-base font-extrabold text-slate-800"><%= voter.nama %> <span class="text-xs font-normal text-slate-500">(<%= voter.kelas %>)</span></h2>
        <p class="text-xs text-slate-400 font-mono">NISN: <%= voter.nisn %></p>
      </div>
    </div>
    <div class="text-right">
      <span class="text-[11px] font-semibold text-slate-400 block uppercase tracking-wider">Prinsip Pemilihan</span>
      <span class="text-xs font-bold text-slate-700 bg-slate-100 px-3 py-1 rounded-full inline-block">
        <i class="fa-solid fa-shield-heart text-rose-500 mr-1"></i>LUBER &amp; JURDIL
      </span>
    </div>
  </div>

  <div class="text-center py-2">
    <h1 class="text-2xl font-black text-slate-900 tracking-tight">SURAT SUARA ELEKTRONIK OSIS &amp; MPK</h1>
    <p class="text-xs text-slate-500 mt-1">Pilih salah satu pasangan calon di bawah ini dengan menekan tombol <strong>"Coblos Paslon Ini"</strong>.</p>
  </div>

  <!-- Candidates Ballot Cards (3 Kolom) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% candidates.forEach(c => { %>
      <div class="bg-white rounded-3xl border-2 border-slate-200 hover:border-indigo-500 shadow-lg hover:shadow-2xl transition duration-300 overflow-hidden flex flex-col group relative">
        
        <!-- Nomor Urut Banner -->
        <div class="bg-gradient-to-r from-indigo-700 to-blue-700 py-3 text-center text-white relative">
          <span class="text-3xl font-black tracking-wider">0<%= c.nomorUrut %></span>
        </div>

        <!-- Foto Paslon -->
        <div class="h-56 bg-gradient-to-b from-slate-100 to-slate-200 flex items-center justify-center p-4 relative overflow-hidden">
          <% if (c.fotoUrl) { %>
            <img src="<%= c.fotoUrl %>" alt="Paslon <%= c.nomorUrut %>" class="max-h-full object-contain group-hover:scale-105 transition duration-500 drop-shadow-md">
          <% } else { %>
            <div class="text-center text-slate-400">
              <i class="fa-solid fa-users text-5xl mb-2 text-slate-300"></i>
              <p class="text-xs font-bold">Paslon No. 0<%= c.nomorUrut %></p>
            </div>
          <% } %>
        </div>

        <!-- Card Content -->
        <div class="p-6 flex-1 flex flex-col">
          <div class="text-center mb-4 pb-3 border-b border-slate-100">
            <h3 class="text-base font-extrabold text-slate-800 leading-snug"><%= c.namaKetua %></h3>
            <p class="text-xs font-bold text-indigo-600 mt-0.5">Calon Ketua OSIS</p>
            <div class="my-1.5 text-slate-300 text-xs">&amp;</div>
            <h4 class="text-sm font-bold text-slate-700 leading-snug"><%= c.namaWakil %></h4>
            <p class="text-xs font-medium text-slate-500 mt-0.5">Calon Wakil Ketua OSIS</p>
          </div>

          <!-- Visi & Misi Accordion / Preview -->
          <div class="space-y-3 mb-6 flex-1 text-xs">
            <div class="bg-indigo-50/60 p-3 rounded-2xl border border-indigo-100">
              <p class="font-bold text-indigo-900 uppercase tracking-wider text-[10px] mb-1">
                <i class="fa-solid fa-bullseye mr-1"></i>Visi:
              </p>
              <p class="text-slate-700 text-xs italic">"<%= c.visi %>"</p>
            </div>

            <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100">
              <p class="font-bold text-slate-700 uppercase tracking-wider text-[10px] mb-1">
                <i class="fa-solid fa-list-ol mr-1"></i>Program Misi:
              </p>
              <div class="text-slate-600 text-[11px] whitespace-pre-line leading-relaxed max-h-32 overflow-y-auto pr-1">
                <%= c.misi %>
              </div>
            </div>
          </div>

          <!-- Tombol Coblos -->
          <div class="pt-2">
            <button type="button" onclick="openConfirmModal('<%= c.id %>', '<%= c.nomorUrut %>', '<%= c.namaKetua %>', '<%= c.namaWakil %>')"
              class="w-full py-3.5 px-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-extrabold rounded-2xl shadow-lg shadow-emerald-600/30 transition transform active:scale-95 flex items-center justify-center space-x-2">
              <i class="fa-solid fa-check-to-slot text-base"></i>
              <span>COBLOS PASLON 0<%= c.nomorUrut %></span>
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- Modal Konfirmasi Coblos (Mencegah salah klik) -->
<div id="confirmModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden p-4">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-100 transform transition-all animate-in fade-in zoom-in duration-200">
    <div class="text-center">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl shadow-inner">
        <i class="fa-solid fa-stamp"></i>
      </div>
      <h3 class="text-lg font-black text-slate-800">Konfirmasi Pencoblosan Suara</h3>
      <p class="text-xs text-slate-500 mt-1">Pastikan pilihan Anda sudah benar sebelum dikirimkan ke kotak suara digital.</p>
    </div>

    <div class="my-5 p-4 rounded-2xl bg-slate-50 border border-slate-200 text-center">
      <span class="text-[10px] font-bold text-indigo-600 uppercase tracking-widest block">Pasangan Calon Pilihan Anda</span>
      <h4 id="modalPaslonNo" class="text-2xl font-black text-slate-900 my-1">Paslon 01</h4>
      <p id="modalPaslonNama" class="text-xs font-bold text-slate-700">Nama Calon</p>
      <div class="mt-3 pt-2 border-t border-slate-200 text-[11px] text-amber-700 font-semibold flex items-center justify-center space-x-1">
        <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
        <span>Pilihan bersifat FINAL &amp; token Anda akan hangus seketika.</span>
      </div>
    </div>

    <!-- Hidden Form Post Coblos -->
    <form action="/pemilih/vote" method="POST" id="voteForm">
      <input type="hidden" name="candidateId" id="modalCandidateId" value="">
      
      <div class="flex items-center space-x-3">
        <button type="button" onclick="closeConfirmModal()"
          class="flex-1 py-3 px-4 border border-slate-200 text-slate-700 hover:bg-slate-100 font-bold text-xs rounded-xl transition">
          Batal / Cek Lagi
        </button>
        <button type="submit"
          class="flex-1 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-xl shadow-lg shadow-emerald-600/30 transition flex items-center justify-center space-x-1.5">
          <i class="fa-solid fa-check"></i>
          <span>Ya, Coblos Sekarang!</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openConfirmModal(id, no, ketua, wakil) {
    document.getElementById('modalCandidateId').value = id;
    document.getElementById('modalPaslonNo').innerText = 'Paslon Nomor Urut 0' + no;
    document.getElementById('modalPaslonNama').innerText = ketua + ' & ' + wakil;
    document.getElementById('confirmModal').classList.remove('hidden');
  }

  function closeConfirmModal() {
    document.getElementById('confirmModal').classList.add('hidden');
  }
</script>

<%- include('../layout/footer') %>
